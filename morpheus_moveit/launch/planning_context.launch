<launch>
  <!-- By default we do not overwrite the URDF. Change the following to true to change the default behavior -->
  <arg name="load_robot_description" default="false"/>
  <arg name="xacro_path" default="$(find morpheus_description)/urdf/scenes/test_scene.xacro"/>
  <arg name="srdf_path" default="$(find morpheus_description)/srdf/scenes/test_scene.srdf"/>
  <arg name="joint_limits_path" default="$(find morpheus_moveit)/config/joint_limits.yaml"/>
  <arg name="cartesian_limits_path" default="$(find morpheus_moveit)/config/cartesian_limits.yaml"/>
  <arg name="kinematics_path" default="$(find morpheus_moveit)/config/ur5e_kinematics.yaml"/>

  <!-- The name of the parameter under which the URDF is loaded -->
  <arg name="robot_description" default="robot_description"/>

  <!-- Load universal robot description format (URDF) -->
  <param if="$(arg load_robot_description)" name="$(arg robot_description)" command="xacro $(arg xacro_path)"/>

  <!-- The semantic description that corresponds to the URDF -->
  <param name="$(arg robot_description)_semantic" command="xacro $(arg srdf_path)"/>

  <!-- Load updated joint limits (override information from URDF) -->
  <group ns="$(arg robot_description)_planning">
    <rosparam command="load" file="$(arg joint_limits_path)"/>
    <rosparam command="load" file="$(arg cartesian_limits_path)"/>
  </group>

  <!-- Load default settings for kinematics; these settings are overridden by settings in a node's namespace -->
  <group ns="$(arg robot_description)_kinematics">
    <rosparam command="load" file="$(arg kinematics_path)"/>

  </group>

</launch>
