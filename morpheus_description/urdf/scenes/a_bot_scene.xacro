<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur">

    <xacro:arg name="use_fake_hardware" default = "true"/>

    <link name="world" />

    <xacro:include filename="$(find morpheus_description)/urdf/macros/simple_pedestal_macro.xacro" />
    <xacro:include filename="$(find morpheus_description)/urdf/macros/a_bot_macro.xacro" />

    <xacro:simple_pedestal
        prefix=""
        parent="world"
        height="${0.0254 * 34.75}"
        radius="0.15"
    />

    <xacro:a_bot
        prefix=""
        parent="world"
        use_fake_hardware="$(arg use_fake_hardware)"
    >
        <origin xyz="0 0 ${0.0254 * 34.75}" rpy="0 0 0" />
    </xacro:a_bot>

    <gazebo>
        <plugin name="ros_control" filename="libgazebo_ros_control.so">
        </plugin>
    </gazebo>
</robot>