<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg name)">
    <!-- Robot Name Arguments -->
    <xacro:arg name="name" default="ur"/>
    <xacro:arg name="tf_prefix" default="" />
    <!-- UR Robot Selection -->
    <xacro:arg name="ur_type" default="ur5e"/>
    <!-- UR Robot Arguments -->
    <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
    <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
    <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
    <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
    <xacro:arg name="safety_limits" default="false"/>
    <xacro:arg name="safety_pos_margin" default="0.15"/>
    <xacro:arg name="safety_k_position" default="20"/>
    <xacro:arg name="force_abs_paths" default="true"/>
    <!-- Wrist Mount Selection -->
    <xacro:arg name="mount_type" default="d415_mount"/>
    <!-- End Effector Selection -->
    <xacro:arg name="ee_type" default="robotiq"/>
    <!-- Common End Effector Arguments -->
    <xacro:arg name="use_mock_hardware" default="false"/>
    <xacro:arg name="sim_gazebo" default="false"/>
    <xacro:arg name="device" default="/dev/ttyUSB0"/>
    <!-- Robotiq Gripper Arguments -->
    <xacro:arg name="sim_topic_based" default="false"/>
    <xacro:arg name="sim_joint_commands_topic" default="/sim_joint_commands_topic"/>
    <xacro:arg name="sim_joint_states_topic" default="/sim_joint_states_topic"/>
    <xacro:arg name="mock_sensor_commands" default="false"/>
    <xacro:arg name="include_ros2_control" default="true"/>
    <xacro:arg name="gripper_speed_multiplier" default="1.0"/>
    <xacro:arg name="gripper_force_multiplier" default="0.5"/>
    <xacro:arg name="gripper_max_speed" default="0.150"/>
    <xacro:arg name="gripper_max_force" default="235.0"/>
    <xacro:arg name="gripper_closed_position" default="0.7929"/>
    <!-- OnRobot Gripper Arguments -->
    <xacro:arg name="connection_type" default="serial"/>
    <xacro:arg name="ip_address" default="192.168.1.1"/>
    <xacro:arg name="port" default="502"/>
    <!-- Additional URDF Files -->
    <xacro:arg name="environment_file" default=""/>
    
    <link name="world"/>

    <!-- Includes -->
    <xacro:include filename="$(find morpheus_description)/urdf/macros/ur_endeffector_macro.xacro" />

    <!-- Robot -->
    <xacro:ur_endeffector
        name="$(arg name)"
        tf_prefix="$(arg tf_prefix)"
        parent="world"

        ur_type="$(arg ur_type)"

        joint_limits_parameters_file="$(arg joint_limit_params)"
        kinematics_parameters_file="$(arg kinematics_params)"
        physical_parameters_file="$(arg physical_params)"
        visual_parameters_file="$(arg visual_params)"
        safety_limits="$(arg safety_limits)"
        safety_pos_margin="$(arg safety_pos_margin)"
        safety_k_position="$(arg safety_k_position)"
        force_abs_paths="$(arg force_abs_paths)"

        mount_type="$(arg mount_type)"

        ee_type="$(arg ee_type)"

        use_mock_hardware="$(arg use_mock_hardware)"
        sim_gazebo="$(arg sim_gazebo)"
        device="$(arg device)"
        
        sim_topic_based="$(arg sim_topic_based)"
        sim_joint_commands_topic="$(arg sim_joint_commands_topic)"
        sim_joint_states_topic="$(arg sim_joint_states_topic)"
        mock_sensor_commands="$(arg mock_sensor_commands)"
        include_ros2_control="$(arg include_ros2_control)"
        gripper_speed_multiplier="$(arg gripper_speed_multiplier)"
        gripper_force_multiplier="$(arg gripper_force_multiplier)"
        gripper_max_speed="$(arg gripper_max_speed)"
        gripper_max_force="$(arg gripper_max_force)"
        gripper_closed_position="$(arg gripper_closed_position)"
        
        connection_type="$(arg connection_type)"
        ip_address="$(arg ip_address)"
        port="$(arg port)"
        >
        <origin xyz="0 0 0" rpy="0 0 0" />          <!-- position robot in the world -->
    </xacro:ur_endeffector>
    
    <!-- Create the environment around the robot -->
    <xacro:property name="environment_file" value="$(arg environment_file)"/>
    <xacro:if value="${environment_file != ''}">
        <xacro:include filename="$(arg environment_file)"/>
    </xacro:if>

</robot>