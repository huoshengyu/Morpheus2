<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="vx300s">

    <xacro:include filename="$(find morpheus_description)/urdf/scenes/trossen_scene.xacro" />

    <xacro:include filename="$(find morpheus_description)/urdf/macros/node2_table.xacro" />
    <xacro:node2_table
        prefix=""
        parent="world"
        x="${0.0254 * (-48)}"
        y="${0.0254 * 8.5}"
        z="${0.0254 * 34.75}"
        scale="1"
    />
    <!-- scale=0.0254 meters/inch -->

</robot>