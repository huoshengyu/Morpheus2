<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="a_bot">

    <xacro:include filename="$(find morpheus_description)/urdf/macros/ur5e_macro.xacro" />
    <xacro:include filename="$(find morpheus_description)/urdf/macros/d415_mount_macro.xacro" />
    <xacro:include filename="$(find robotiq_2f_85_gripper_description)/urdf/robotiq_arg2f_85_macro.xacro" />

    <xacro:macro name="a_bot"
        params="
        prefix 
        parent 
        *origin">

        <xacro:ur5e
            tf_prefix="${prefix}"
            parent="${parent}"
            tcp_offset="0.163"
        >
            <xacro:insert_block name="origin" />
        </xacro:ur5e>

        <xacro:d415_mount
            prefix="${prefix}"
            parent="${prefix}wrist_3_link"
        >
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:d415_mount>

        <xacro:robotiq_arg2f_85
            prefix="${prefix}"
            parent="${prefix}d415_mount_attach_link"
            transmission_hw_interface="hardware_interface/PositionJointInterface"
            add_cable_protector="true"
        >
            <origin xyz="0 0 0.003" rpy="0 0 ${pi}" />
        </xacro:robotiq_arg2f_85>

    </xacro:macro>

</robot>