<robot name="dragon_mesh" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="dragon_mesh"
        params="
        prefix 
        parent
        scale:=1
        *origin">

        <xacro:property name="scale_mm" value="${scale * 0.0254}"/>

        <link name="${prefix}dragon_mesh">
            <inertial>
                <origin rpy="0 0 0" xyz="${scale_mm * 0.0} ${scale_mm * 0.0} ${scale_mm * 2}"/>
                <mass value="0.05"/>
                <inertia ixx="5" ixy="0" ixz="0" iyy="5" iyz="0" izz="12"/>
            </inertial>
            <visual>
                <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find morpheus_description)/meshes/visual/dragon_simple.obj" scale="${scale_mm} ${scale_mm} ${scale_mm}"/>
                </geometry>
                <material name="grey">
                    <color rgba="0.3 0.3 0.3 1" />
                </material>
            </visual>
            <collision>
                <origin rpy="1.57079632679 0 0" xyz="0 0 0" />
                <geometry>
                    <mesh filename="file://$(find morpheus_description)/meshes/collision/dragon_simple.obj" scale="${scale_mm} ${scale_mm} ${scale_mm}"/>
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}dragon_simple_joint" type="fixed">
            <parent link="${parent}" />
            <child link="${prefix}dragon_simple" />
            <xacro:insert_block name="origin" />
        </joint>

    </xacro:macro>

</robot>