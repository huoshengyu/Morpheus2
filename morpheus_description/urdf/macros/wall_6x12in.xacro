<robot name="wall_6x12in" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="wall_6x12in"
    params="x:=0 y:=0 z:=0 R:=0 P:=0 Y:=0 scale:=0.0254 prefix parent">

    <link name="${prefix}wall_6x12in">
        <inertial>
            <origin rpy="0 0 0" xyz="${scale * 6} ${scale * 3} ${scale * 0.5}"/>
            <mass value="1"/>
            <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
        </inertial>
        <visual>
            <origin rpy="0 0 1.57079632679" xyz="${scale * 12} 0.0 0.0"/>
            <geometry>
                <mesh filename="file://$(find morpheus_description)/meshes/visual/wall_6x12in.obj" scale="${scale} ${scale} ${scale}"/>
            </geometry>
            <material name="grey">
                <color rgba="0.3 0.3 0.3 1" />
            </material>
        </visual>
        <collision>
            <origin rpy="0 0 1.57079632679" xyz="${scale * 12} 0.0 0.0"/>
            <geometry>
                <mesh filename="file://$(find morpheus_description)/meshes/collision/wall_6x12in.obj" scale="${scale} ${scale} ${scale}"/>
            </geometry>
        </collision>
    </link>

    <joint name="${prefix}wall_6x12in_joint" type="fixed">
        <parent link="${parent}" />
        <child link="${prefix}wall_6x12in" />
        <origin xyz="${x} ${y} ${z}" rpy="${R} ${P} ${Y}" />
    </joint>

  </xacro:macro>

</robot>