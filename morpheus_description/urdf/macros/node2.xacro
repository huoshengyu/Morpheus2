<?xml version="1.0"?>
<robot name="node2" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="node2"
    params="
    prefix 
    parent
    height:=0.335 
    radius:=0.11 
    scale:=1
    *origin">

    <link name="${prefix}node2">
      <visual>
        <origin xyz="0 ${height / 2} 0" rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder length="${height * scale}" radius="${radius * scale}"/>
        </geometry>
        <material name="grey">
            <color rgba="0.3 0.3 0.3 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 ${height / 2} 0" rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder length="${height * scale}" radius="${radius * scale}"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}PMA3">
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0.15"/>
            <inertia ixx="${scale * 1.0}" ixy="0" ixz="0" iyy="${scale * 1.0}" iyz="0" izz="${scale * 1.0}"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="file://$(find morpheus_description)/meshes/visual/PMA3.stl" scale="${scale * 0.001} ${scale * 0.001} ${scale * 0.001}"/>
            </geometry>
            <material name="grey">
                <color rgba="0.3 0.3 0.3 1" />
            </material>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="file://$(find morpheus_description)/meshes/collision/PMA3.stl" scale="${scale * 0.001} ${scale * 0.001} ${scale * 0.001}"/>
            </geometry>
        </collision>
    </link>

    <joint name="${prefix}node2_joint" type="fixed">
        <parent link="${parent}" />
        <child link="${prefix}node2" />
        <xacro:insert_block name="origin" />
    </joint>

    <joint name="${prefix}PMA3_joint" type="fixed">
        <parent link="${prefix}node2" />
        <child link="${prefix}PMA3" />
        <origin xyz="0 -0.1 -0.035" rpy="${pi/2} 0 ${-pi/2}" />
    </joint>
  </xacro:macro>
  

</robot>